# Telegram
BOT_TOKEN=123456789:replace-with-botfather-token
CHAT_ID=111111111            # comma-separated for several users

# Proxmox API token (role PVEAuditor on /)
PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006
PROXMOX_NODE=
PROXMOX_TOKEN_ID=root@pam!botmon
PROXMOX_TOKEN_SECRET=replace-me
PROXMOX_VERIFY_TLS=false

# WireGuard host reached over SSH with a dedicated key
WG_HOST=192.168.1.20
WG_USER=root
WG_IFACE=wg0
WG_SSH_KEY=/opt/telegrambot/botmon_ed25519

# Optional
POLL_SECONDS=60
HANDSHAKE_ONLINE_SEC=180
VMID_WATCH=
SERVICE_WATCH=pveproxy,pve-cluster,sshd
SITE_NAME=Proxmox
